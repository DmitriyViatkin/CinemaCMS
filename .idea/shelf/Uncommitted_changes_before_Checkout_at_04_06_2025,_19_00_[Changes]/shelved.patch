+        {% for field in picture_formset.empty_form %}
+            {% if field.name == 'image' %}
+                <div class="form-group">
+                    {{ field.label_tag }}
+                    {{ field }}
+                    {% if field.help_text %}<small class="form-text text-muted">{{ field.help_text }}</small>{% endif %} {# ИСПРАВЛЕНО: добавлен пробел #}
+                    {% for error in field.errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
+                </div>
+                <div class="image-preview" style="max-width: 100px; max-height: 100px; margin-top: 10px;"></div>
+            {% elif field.name == 'DELETE' %}
+                <div class="form-group form-check">
+                    {{ field }}
+                    {{ field.label_tag }}
+                    {% for error in field.errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
+                </div>
+            {% else %}
+                {# Эти поля (image_type, gallery, id) будут скрыты благодаря HiddenInput в PictureForm #}
+                {{ field }}
+            {% endif %}
+        {% endfor %}
+        <button type="button" class="btn btn-danger mt-2 remove-form">Видалити</button>
