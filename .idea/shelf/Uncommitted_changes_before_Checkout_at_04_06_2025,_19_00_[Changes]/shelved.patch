+{% extends 'admin/index.html' %}
+
+{% block title %}Список новин{% endblock %}
+{% block content %}
+<section class="content">
+    <div class="container-fluid">
+        <div class="row">
+            <div class="col-12">
+                <div class="card">
+                    <div class="card-header d-flex justify-content-between align-items-center">
+                        <h3 class="card-title mb-0">Список сторінок</h3>
+                        <div class="card-tools">
+
+                            <a href="{% url 'add_paige' %}" class="btn btn-success btn-sm">
+                                <i class="fas fa-plus"></i> Додати сторінку        </a>
+                        </div>
+                    </div>
+                    <div class="card-body">
+
+                        <table id="news_Table" class="table table-bordered table-hover">
+                            <thead>
+                                <tr>
+                                    <th>Назва</th>
+                                    <th>Дата створення</th>
+                                    <th>Статус</th>
+                                </tr>
+                            </thead>
+
+                                {% for paige in paiges %}
+                                <tr>
+                                    <td>{{ paige.title }}</td>
+                                    <td>{{ paige.date|date:"d.m.Y" }}</td>
+                                    <td>{{ paige.is_active }}</td>
+                                    <td>
+
+                                       <a href="{% url 'edit_paige' paige.pk %}" class="btn btn-primary btn-sm">Редагувати</a>
+                                   <form action="{% url 'delete_paige' paige_id=paige.pk %}" method="post" style="display:inline;">
+
+                                            {% csrf_token %}
+
+                                            <button type="submit" class="btn btn-danger btn-sm"
+                                                    onclick="return confirm('Ви впевнені, що хочете видалити сторінку {{ paige.title }}?');">
+                                                Видалити
+                                            </button>
+                                   </form>
+                                    </td>
+                                </tr>
+                                {% empty %}
+
+                                <tr>
+                                      <td colspan="7">Список сторінок пустий.</td>
+                                </tr>
+                                {% endfor %}
+                            </tbody>
+                        </table>
+                    </div>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </section>
+{% endblock %}
