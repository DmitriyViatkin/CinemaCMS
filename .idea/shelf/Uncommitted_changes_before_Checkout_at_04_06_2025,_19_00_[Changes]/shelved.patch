<+>{% extends 'admin/index.html' %}\n{% load static %}\n{% block title %}Додати фільм{% endblock %}\n\n{% block content %}\n<h1>Додати новий фільм</h1>\n\n<section class=\"content\" >\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"col-md-12\">\n                <div class=\"card card-primary\">\n                    <div class=\"card-header\">\n                        <h3 class=\"card-title\">Додати фільм</h3>\n                    </div>\n                    <form method=\"post\" enctype=\"multipart/form-data\">\n                        {% csrf_token %}\n\n                        {% if movie_form.non_field_errors %}\n                            <div class=\"alert alert-danger\">{{ movie_form.non_field_errors }}</div>\n                        {% endif %}\n                        {% if block_seo_form.non_field_errors %}\n                            <div class=\"alert alert-danger\">{{ block_seo_form.non_field_errors }}</div>\n                        {% endif %}\n                        {% if gallery_form.non_field_errors %}\n                            <div class=\"alert alert-danger\">{{ gallery_form.non_field_errors }}</div>\n                        {% endif %}\n                        {% if picture_formset.non_form_errors %}\n                            <div class=\"alert alert-danger\">{{ picture_formset.non_form_errors }}</div>\n                        {% endif %}\n                        {% if main_picture_form.non_field_errors %}\n                            <div class=\"alert alert-danger\">{{ main_picture_form.non_field_errors }}</div>\n                        {% endif %}\n\n                        <div class=\"card-body\">\n                            <h2>Інформація про фільм</h2>\n                            {% include 'admin/card_forms/movie_form.html' with form=movie_form %}\n\n                            <h2>SEO Інформація</h2>\n                            {% include 'admin/card_forms/seo_form.html' with form=block_seo_form %}\n\n                            <h2>Галерея</h2>\n\n\n                            <h3>Головна картинка</h3>\n                            <div class=\"main-picture-form border p-3 mb-3\">\n                                {% for field in main_picture_form %}\n                                    {% if field.name == 'image' %}\n                                        <div class=\"form-group\">\n                                            {{ field.label_tag }}\n                                            {{ field }}\n                                            {% if field.errors %}\n                                                <div class=\"alert alert-danger\">{{ field.errors }}</div>\n                                            {% endif %}\n                                            <div class=\"image-preview\" style=\"max-width: 200px; max-height: 200px; margin-top: 10px;\"></div>\n                                        </div>\n                                    {% endif %}\n                                {% endfor %}\n                                <div style=\"display: none;\">{{ main_picture_form.image_type.label_tag }} {{ main_picture_form.image_type }}</div>\n                                <div style=\"display: none;\">{{ main_picture_form.gallery.label_tag }} {{ main_picture_form.gallery }}</div>\n                            </div>\n\n                            <h3>Картинки галереї</h3>\n                            {{ picture_formset.management_form }}\n                            <div id=\"pictures-formset\">\n                                {% for form in picture_formset %}\n                                    <div class=\"gallery-image-form border p-3 mb-3\">\n                                        <div style=\"display: none;\">{{ form.id }}</div>\n                                        {% if form.non_field_errors %}<div class=\"alert alert-danger\">{{ form.non_field_errors }}</div>{% endif %}\n                                        <div class=\"form-group\">\n                                            {{ form.image.label_tag }}\n                                            {% if form.instance.pk and form.instance.image %}\n                                                <img src=\"{{ form.instance.image.url }}\" alt=\"Поточне зображення\" style=\"max-width: 100px; max-height: 100px; margin-bottom: 10px;\">\n                                            {% endif %}\n                                            {{ form.image }}\n                                            {% if form.image.help_text %}<small class=\"form-text text-muted\">{{ form.image.help_text }}</small>{% endif %}\n                                            {% for error in form.image.errors %}<div class=\"alert alert-danger\">{{ error }}</div>{% endfor %}\n                                        </div>\n                                        <div class=\"form-group form-check\">\n                                            {{ form.DELETE }}\n                                            {{ form.DELETE.label_tag }}\n                                            {% for error in form.DELETE.errors %}<div class=\"alert alert-danger\">{{ error }}</div>{% endfor %}\n                                        </div>\n                                        <div style=\"display: none;\">{{ form.image_type.label_tag }} {{ form.image_type }}</div>\n                                        <div class=\"form-group\" style=\"display: none;\">\n                                            <label for=\"{{ form.prefix }}-gallery\">Gallery:</label>\n                                            {{ form.gallery }}\n                                        </div>\n                                    </div>\n                                {% endfor %}\n                                {{ picture_formset.empty_form }}\n                            </div>\n                            <button id=\"add-picture-form\" type=\"button\" class=\"btn btn-success mt-2\">Додати ще одне зображення</button>\n                        </div>\n\n                        <div class=\"card-footer\">\n                            <button type=\"submit\" class=\"btn btn-primary\">Створити</button>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            // Предварительный просмотр главной картинки\n            const mainPictureInput = document.querySelector('.main-picture-form input[type=\"file\"]');\n            const mainPicturePreview = document.querySelector('.main-picture-form .image-preview');\n\n            if (mainPictureInput && mainPicturePreview) {\n                mainPictureInput.addEventListener('change', function() {\n                    previewImage(this, mainPicturePreview, 200, 200);\n                });\n            }\n\n            // Обработка формсета галереи\n            const addPictureFormButton = document.getElementById('add-picture-form');\n            const picturesFormsetContainer = document.getElementById('pictures-formset');\n            const emptyFormTemplate = document.querySelector('#empty-form .gallery-image-form').cloneNode(true);\n            const totalForms = document.querySelector('#id_pictures-TOTAL_FORMS');\n            let formCount = picturesFormsetContainer.querySelectorAll('.gallery-image-form').length;\n\n            function updateFormIndices(form, newIndex) {\n                form.querySelectorAll('input, select, textarea, label').forEach(node => {\n                    let id = node.getAttribute('id');\n                    let name = node.getAttribute('name');\n\n                    if (id && id.includes('__prefix__')) {\n                        node.setAttribute('id', id.replace('__prefix__', newIndex));\n                    } else if (id && id.includes('-')) {\n                        const parts = id.split('-');\n                        node.setAttribute('id', parts[0] + '-' + newIndex + '-' + parts.slice(2).join('-'));\n                    }\n\n                    if (name && name.includes('__prefix__')) {\n                        node.setAttribute('name', name.replace('__prefix__', newIndex));\n                    } else if (name && name.startsWith('pictures-')) {\n                        const parts = name.split('-');\n                        node.setAttribute('name', 'pictures-' + newIndex + '-' + parts.slice(2).join('-'));\n                    }\n\n                    if (node.tagName === 'LABEL' && node.getAttribute('for') && node.getAttribute('for').includes('__prefix__')) {\n                        node.setAttribute('for', node.getAttribute('for').replace('__prefix__', newIndex));\n                    } else if (node.tagName === 'LABEL' && node.getAttribute('for') && node.getAttribute('for').startsWith('id_pictures-')) {\n                        const parts = node.getAttribute('for').split('-');\n                        node.setAttribute('for', 'id_pictures-' + newIndex + '-' + parts.slice(2).join('-'));\n                    }\n\n                    if (node.tagName === 'INPUT' && node.getAttribute('type') === 'file') {\n                        const preview = form.querySelector('.image-preview');\n                        if (preview) preview.innerHTML = '';\n                        node.addEventListener('change', function() {\n                            previewImage(this, preview, 100, 100);\n                        });\n                    }\n                });\n            }\n\n            function previewImage(input, previewContainer, maxWidth, maxHeight) {\n                if (input.files && input.files[0]) {\n                    const reader = new FileReader();\n                    reader.onload = function(e) {\n                        previewContainer.innerHTML = `<img src=\"${e.target.result}\" style=\"max-width: ${maxWidth}px; max-height: ${maxHeight}px;\">`;\n                    }\n                    reader.readAsDataURL(input.files[0]);\n                } else {\n                    previewContainer.innerHTML = '';\n                }\n            }\n\n            addPictureFormButton.addEventListener('click', function() {\n                const newForm = emptyFormTemplate.cloneNode(true);\n                updateFormIndices(newForm, formCount);\n\n                const deleteButton = document.createElement('button');\n                deleteButton.classList.add('btn', 'btn-danger', 'mt-2', 'remove-form');\n                deleteButton.textContent = 'Видалити';\n                deleteButton.addEventListener('click', function() {\n                    newForm.remove();\n                    formCount--;\n                    totalForms.value = formCount;\n                    updateFormIndicesOnDelete();\n                });\n                newForm.appendChild(deleteButton);\n\n                picturesFormsetContainer.appendChild(newForm);\n                formCount++;\n                totalForms.value = formCount;\n\n                // Скрываем поля id и image_type в новой форме\n                const newIdField = newForm.querySelector('[id$=\"-id\"]');\n                if (newIdField) {\n                    newIdField.closest('.form-group').style.display = 'none';\n                }\n                const newImageTypeField = newForm.querySelector('[id$=\"-image_type\"]');\n                if (newImageTypeField) {\n                    newImageTypeField.closest('.form-group').style.display = 'none';\n                }\n\n                // Скрываем label поля image_type в новой форме\n                const newImageTypeLabel = newForm.querySelector('label[for$=\"-image_type\"]');\n                if (newImageTypeLabel) {\n                    newImageTypeLabel.style.display = 'none';\n                }\n\n                // Скрываем label и поле Gallery в новой форме\n                const newGalleryLabel = newForm.querySelector('label[for$=\"-gallery\"]');\n                const newGalleryField = newForm.querySelector('[id$=\"-gallery\"]');\n                if (newGalleryLabel) {\n                    newGalleryLabel.style.display = 'none';\n                }\n                if (newGalleryField) {\n                    newGalleryField.closest('.form-group').style.display = 'none';\n                }\n            });\n\n            picturesFormsetContainer.addEventListener('click', function(event) {\n                if (event.target.classList.contains('remove-form')) {\n                    event.preventDefault();\n                    const formToDelete = event.target.closest('.gallery-image-form');\n                    const indexToRemove = Array.from(picturesFormsetContainer.children).indexOf(formToDelete);\n                    formToDelete.remove();\n                    formCount--;\n                    totalForms.value = formCount;\n                    updateFormIndicesOnDelete();\n                }\n            });\n\n            function updateFormIndicesOnDelete() {\n                const forms = picturesFormsetContainer.querySelectorAll('.gallery-image-form');\n                forms.forEach((form, index) => {\n                    updateFormIndices(form, index);\n                    // Скрываем поля id и image_type после обновления индексов\n                    const idField = form.querySelector('[id$=\"-id\"]');\n                    if (idField) {\n                        idField.closest('.form-group').style.display = 'none';\n                    }\n                    const imageTypeField = form.querySelector('[id$=\"-image_type\"]');\n                    if (imageTypeField) {\n                        imageTypeField.closest('.form-group').style.display = 'none';\n                    }\n                    // Скрываем label поля image_type после обновления индексов\n                    const imageTypeLabel = form.querySelector('label[for$=\"-image_type\"]');\n                    if (imageTypeLabel) {\n                        imageTypeLabel.style.display = 'none';\n                    }\n                    // Скрываем label и поле Gallery после обновления индексов\n                    const galleryLabel = form.querySelector('label[for$=\"-gallery\"]');\n                    const galleryField = form.querySelector('[id$=\"-gallery\"]');\n                    if (galleryLabel) {\n                        galleryLabel.style.display = 'none';\n                    }\n                    if (galleryField) {\n                        galleryField.closest('.form-group').style.display = 'none';\n                    }\n                });\n            }\n\n            picturesFormsetContainer.querySelectorAll('.gallery-image-form').forEach((form, index) => {\n                updateFormIndices(form, index);\n                const fileInput = form.querySelector('input[type=\"file\"]');\n                const previewContainer = form.querySelector('.image-preview');\n                if (fileInput && previewContainer) {\n                    fileInput.addEventListener('change', function() {\n                        previewImage(this, previewContainer, 100, 100);\n                    });\n                }\n                // Скрываем поля id и image_type при загрузке страницы\n                const initialIdField = form.querySelector('[id$=\"-id\"]');\n                if (initialIdField) {\n                    initialIdField.closest('.form-group').style.display = 'none';\n                }\n                const initialImageTypeField = form.querySelector('[id$=\"-image_type\"]');\n                if (initialImageTypeField) {\n                    initialImageTypeField.closest('.form-group').style.display = 'none';\n                }\n                // Скрываем label поля image_type при загрузке страницы\n                const initialImageTypeLabel = form.querySelector('label[for$=\"-image_type\"]');\n                if (initialImageTypeLabel) {\n                    initialImageTypeLabel.style.display = 'none';\n                }\n                // Скрываем label и поле Gallery при загрузке страницы\n                const initialGalleryLabel = form.querySelector('label[for$=\"-gallery\"]');\n                const initialGalleryField = form.querySelector('[id$=\"-gallery\"]');\n                if (initialGalleryLabel) {\n                    initialGalleryLabel.style.display = 'none';\n                }\n                if (initialGalleryField) {\n                    initialGalleryField.closest('.form-group').style.display = 'none';\n                }\n            });\n\n            // Скрываем поля id и image_type в пустой форме\n            const emptyFormDiv = document.querySelector('#empty-form .gallery-image-form');\n            if (emptyFormDiv) {\n                const idFieldEmpty = emptyFormDiv.querySelector('[id$=\"__prefix__-id\"]');\n                if (idFieldEmpty) {\n                    idFieldEmpty.closest('.form-group').style.display = 'none';\n                }\n                const imageTypeFieldEmpty = emptyFormDiv.querySelector('[id$=\"__prefix__-image_type\"]');\n                if (imageTypeFieldEmpty) {\n                    imageTypeFieldEmpty.closest('.form-group').style.display = 'none';\n                }\n                // Скрываем label поля image_type в пустой форме\n                const imageTypeLabelEmpty = emptyFormDiv.querySelector('label[for$=\"__prefix__-image_type\"]');\n                if (imageTypeLabelEmpty) {\n                    imageTypeLabelEmpty.style.display = 'none';\n                }\n                // Скрываем label и поле Gallery в пустой форме\n                const galleryLabelEmpty = emptyFormDiv.querySelector('label[for$=\"__prefix__-gallery\"]');\n                const galleryFieldEmpty = emptyFormDiv.querySelector('[id$=\"__prefix__-gallery\"]');\n                if (galleryLabelEmpty) {\n                    galleryLabelEmpty.style.display = 'none';\n                }\n                if (galleryFieldEmpty) {\n                    galleryFieldEmpty.closest('.form-group').style.display = 'none';\n                }\n            }\n\n            // Скрываем label главной картинки \"Тип зображення\" и \"Галерея\"\n            const mainImageTypeLabel = document.querySelector('.main-picture-form label[for$=\"-image_type\"]');\n            if (mainImageTypeLabel) {\n                mainImageTypeLabel.style.display = 'none';\n            }\n            const mainGalleryLabel = document.querySelector('.main-picture-form label[for$=\"-gallery\"]');\n            if (mainGalleryLabel) {\n                mainGalleryLabel.style.display = 'none';\n            }\n        });\n    </script>\n\n    <div style=\"display: none;\">\n        {{ picture_formset.empty_form }}\n        <div id=\"empty-form\">\n            <div class=\"gallery-image-form border p-3 mb-3\">\n                {% for field in picture_formset.empty_form %}\n                    <div class=\"form-group\">\n                        {{ field.label_tag }}\n                        {{ field }}\n                        {% if field.help_text %}<small class=\"form-text text-muted\">{{ field.help_text }}</small>{% endif %}\n                        {% for error in field.errors %}<div class=\"alert alert-danger\">{{ error }}</div>{% endfor %}\n                    </div>\n                {% endfor %}\n                <div class=\"image-preview\" style=\"max-width: 100px; max-height: 100px; margin-top: 10px;\"></div>\n            </div>\n        </div>\n    </div>\n\n\n{% endblock %}
