+                        {% endif %}
+                        {% if picture_formset.non_form_errors %}
+                            <div class="alert alert-danger">{{ picture_formset.non_form_errors }}</div>
+                        {% endif %}
+                        {% if main_picture_form.non_field_errors %}
+                            <div class="alert alert-danger">{{ main_picture_form.non_field_errors }}</div>
+                        {% endif %}
+
+                        <div class="card-body">
+                            <h2>Інформація про сторінку </h2>
+
+                                        <div class="card-body">
+                                              <div class="form-group">
+                                                    {{ paige_form.title.label_tag }}
+                                                    {{ paige_form.title }}
+                                                    {% if paige_form.title.help_text %}<small class="form-text text-muted">{{ paige_form.title.help_text }}</small>{% endif %}
+                                                    {% for error in paige_form.title.errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
+
+                                                    {{ paige_form.date.label_tag }}
+                                                    {{ paige_form.date }}
+                                                    {% if paige_form.date.help_text %}<small class="form-text text-muted">{{ paige_form.date.help_text }}</small>{% endif %}
+                                                    {% for error in paige_form.date.errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
+
+                                                    {{ paige_form.is_active.label_tag }}
+                                                    {{ paige_form.is_active }}
+                                                    {% if paige_form.is_active.help_text %}<small class="form-text text-muted">{{ paige_form.gallery.help_text }}</small>{% endif %}
+                                                    {% for error in paige_form.is_active.errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
+
+
+                                              </div>
